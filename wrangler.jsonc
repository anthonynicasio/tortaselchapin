{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tortas-el-chapin",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
