---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/oswald/700.css';

import brandFoodTruck from '../assets/brand-food-truck.jpg';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import StickyBar from '../components/StickyBar.astro';
import { business, type LocationId } from '../data/business';
import {
  getSiteOrigin,
  localizedUrl,
  t,
  type Locale,
} from '../i18n/utils';
import { isOrderingEnabled } from '../lib/square';
import '../styles/global.css';

export interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  jsonLdGraph?: Record<string, unknown>[];
  hideSticky?: boolean;
  stickyLocation?: LocationId;
}

const {
  locale,
  title,
  description,
  canonicalPath,
  jsonLdGraph = [],
  hideSticky = false,
  stickyLocation = 'silver-spring',
} = Astro.props;
const orderingEnabled = isOrderingEnabled();
const canonicalUrl = localizedUrl(locale, canonicalPath);
const englishUrl = localizedUrl('en', canonicalPath);
const spanishUrl = localizedUrl('es', canonicalPath);
const imageUrl = new URL(brandFoodTruck.src, getSiteOrigin()).toString();
const ogLocale = locale === 'es' ? 'es_US' : 'en_US';
const alternateOgLocale = locale === 'es' ? 'en_US' : 'es_US';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#c8102e" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- [PLACEHOLDER: Replace the public domain before launch.] -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={business.name} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateOgLocale} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={business.name} />

    <JsonLd graph={jsonLdGraph} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(locale, 'a11y.skipToContent')}</a>
    <Header
      locale={locale}
      currentPath={Astro.url.pathname}
      orderingEnabled={orderingEnabled}
    />
    <slot />
    <Footer locale={locale} />
    {
      !hideSticky && (
        <StickyBar
          locale={locale}
          orderingEnabled={orderingEnabled}
          locationId={stickyLocation}
        />
      )
    }
  </body>
</html>
