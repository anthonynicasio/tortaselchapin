---
export type DoodleKind =
  | 'star'
  | 'sparkle'
  | 'crown'
  | 'lines'
  | 'heart'
  | 'jalapeno';

export interface Props {
  kind: DoodleKind;
  color?: 'gold' | 'red';
  size?: number;
  class?: string;
}

const { kind, color = 'gold', size = 40, class: className } = Astro.props;
---

<span
  class:list={['doodle', `doodle--${color}`, className]}
  style={`width:${size}px;height:${size}px;`}
  aria-hidden="true"
>
  <svg
    viewBox="0 0 48 48"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {
      kind === 'star' && (
        <path
          d="M24 5 29 17.8 43 18.6 32.4 27.4 36 41 24 33.6 12 41 15.6 27.4 5 18.6 19 17.8Z"
          fill="currentColor"
        />
      )
    }
    {
      kind === 'sparkle' && (
        <path d="M24 6C26 16.4 27.6 18 38 20 27.6 22 26 23.6 24 34 22 23.6 20.4 22 10 20 20.4 18 22 16.4 24 6ZM37 33v8M33 37h8" />
      )
    }
    {
      kind === 'crown' && (
        <path
          d="M7.5 36 5.5 15 16.5 24.5 24 9 31.5 24.5 42.5 15 40.5 36Z"
          fill="currentColor"
        />
      )
    }
    {
      kind === 'lines' && (
        <path d="M9 14C13.5 12 18 10.4 22.5 8.8M11 26.5C16.5 24.4 21 22.8 26.5 20.8M9 39C13.5 37 18 35.4 22.5 33.8" />
      )
    }
    {
      kind === 'heart' && (
        <path d="M24 41C11.5 32 5.8 22.2 11.6 15 16.2 9.4 24 13.4 24 19.2 24 13.4 31.8 9.4 36.4 15 42.2 22.2 36.5 32 24 41Z" />
      )
    }
    {
      kind === 'jalapeno' && (
        <path d="M29 6C33 7 34 11 31 14M31 14C40.5 20 39.5 30.5 28.5 37.5 18 44 8.5 40.5 9.5 36 16.5 39 23.5 35 26.5 26.5 28.5 20.5 29 17 31 14Z" />
      )
    }
  </svg>
</span>

<style>
  .doodle--gold {
    color: var(--gold);
  }

  .doodle--red {
    color: var(--red);
  }
</style>
