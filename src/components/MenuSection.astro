---
import { t, type Locale } from '../i18n/utils';
import type { MenuItem as MenuItemData } from '../lib/catalog';
import MenuItem from './MenuItem.astro';

export interface Props {
  locale: Locale;
  sectionId: string;
  heading: string;
  items: MenuItemData[];
  orderingEnabled: boolean;
}

const { locale, sectionId, heading, items, orderingEnabled } = Astro.props;
---

<section class="menu-section" id={sectionId}>
  <h2>{heading}</h2>
  {
    items.length > 0 ? (
      <div class="menu-section__items">
        {items.map((item) => (
          <MenuItem
            locale={locale}
            item={item}
            orderingEnabled={orderingEnabled}
          />
        ))}
      </div>
    ) : (
      <p class="empty">{t(locale, 'menu.emptySection')}</p>
    )
  }
</section>

<style>
  .menu-section {
    scroll-margin-top: 9rem;
    padding: clamp(1.4rem, 4vw, 2.4rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: var(--shadow);
  }

  h2 {
    padding-bottom: 0.9rem;
    margin-bottom: 1.4rem;
    border-bottom: 5px solid var(--color-red);
    font-size: clamp(2rem, 6vw, 3rem);
  }

  .empty {
    margin-bottom: 0;
    color: var(--color-muted);
  }
</style>
