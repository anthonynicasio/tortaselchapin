---
import Breadcrumbs from '../Breadcrumbs.astro';
import LocationCard from '../LocationCard.astro';
import { t, type Locale } from '../../i18n/utils';
import Base from '../../layouts/Base.astro';
import { breadcrumbSchema, webPageSchema } from './schema';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const graph = [
  webPageSchema(
    locale,
    '/locations',
    t(locale, 'seo.locations.title'),
    t(locale, 'seo.locations.description'),
  ),
  breadcrumbSchema(locale, [
    { name: t(locale, 'breadcrumbs.locations'), path: '/locations' },
  ]),
];
---

<Base
  locale={locale}
  title={t(locale, 'seo.locations.title')}
  description={t(locale, 'seo.locations.description')}
  canonicalPath="/locations"
  jsonLdGraph={graph}
>
  <main id="main-content">
    <div class="container">
      <Breadcrumbs
        locale={locale}
        items={[{ label: t(locale, 'breadcrumbs.locations') }]}
      />
    </div>

    <section class="section locations-page">
      <div class="container">
        <div class="section-heading">
          <h1>{t(locale, 'locations.heading')}</h1>
          <p>{t(locale, 'locations.intro')}</p>
        </div>
        <div class="location-grid">
          <LocationCard locale={locale} locationId="silver-spring" />
          <LocationCard locale={locale} locationId="hyattsville" />
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .locations-page {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  h1 {
    margin-bottom: 0.8rem;
    font-size: clamp(2.8rem, 9vw, 5.5rem);
  }

  .section-heading p {
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .location-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 820px) {
    .location-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
