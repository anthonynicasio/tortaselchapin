---
import { Picture } from 'astro:assets';

import brandFoodTruck from '../../assets/brand-food-truck.png';
import Breadcrumbs from '../Breadcrumbs.astro';
import { business } from '../../data/business';
import { localizedPath, t, type Locale } from '../../i18n/utils';
import Base from '../../layouts/Base.astro';
import { breadcrumbSchema, organizationSchema } from './schema';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const graph = [
  organizationSchema(locale),
  breadcrumbSchema(locale, [
    { name: t(locale, 'breadcrumbs.about'), path: '/about' },
  ]),
];
---

<Base
  locale={locale}
  title={t(locale, 'seo.about.title')}
  description={t(locale, 'seo.about.description')}
  canonicalPath="/about"
  jsonLdGraph={graph}
>
  <main id="main-content">
    <div class="container">
      <Breadcrumbs
        locale={locale}
        items={[{ label: t(locale, 'breadcrumbs.about') }]}
      />
    </div>

    <section class="section about-page">
      <div class="container about-grid">
        <div class="about-copy">
          <p class="eyebrow">{business.name}</p>
          <h1>{t(locale, 'about.heading')}</h1>
          <p class="body-copy">{t(locale, 'about.body')}</p>
          <p class="tagline">{t(locale, 'home.why.heading')}</p>
          <a class="button" href={localizedPath(locale, '/locations')}>
            {t(locale, 'about.seeLocations')}
          </a>
        </div>
        <div class="about-art">
          <Picture
            src={brandFoodTruck}
            formats={['avif', 'webp']}
            fallbackFormat="png"
            width={800}
            height={800}
            alt={t(locale, 'about.photoAlt')}
            loading="lazy"
            quality={82}
          />
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .about-page {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .about-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  h1 {
    margin-bottom: 1.2rem;
    font-size: clamp(2.8rem, 9vw, 5.5rem);
  }

  .body-copy {
    max-width: 720px;
    color: var(--color-muted);
    font-size: clamp(1rem, 2.5vw, 1.15rem);
  }

  .tagline {
    padding-left: 1rem;
    margin-block: 1.5rem;
    border-left: 6px solid var(--color-red);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .about-art {
    background: transparent;
  }

  .about-art :global(picture),
  .about-art :global(img) {
    width: 100%;
    height: 100%;
  }

  .about-art :global(img) {
    object-fit: contain;
    filter: drop-shadow(0 16px 28px rgb(27 27 27 / 22%));
  }

  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr) minmax(380px, 0.9fr);
      gap: clamp(2rem, 6vw, 5rem);
    }
  }
</style>
