---
import { business } from '../../data/business';
import { localizedPath, t, type Locale } from '../../i18n/utils';
import Base from '../../layouts/Base.astro';
import { breadcrumbSchema, webPageSchema } from './schema';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const graph = [
  webPageSchema(
    locale,
    '/order/error',
    t(locale, 'seo.error.title'),
    t(locale, 'seo.error.description'),
  ),
  breadcrumbSchema(locale, [
    { name: t(locale, 'breadcrumbs.order'), path: '/order' },
    { name: t(locale, 'error.title'), path: '/order/error' },
  ]),
];
---

<Base
  locale={locale}
  title={t(locale, 'seo.error.title')}
  description={t(locale, 'seo.error.description')}
  canonicalPath="/order/error"
  jsonLdGraph={graph}
>
  <main id="main-content" class="section">
    <div class="container">
      <section class="error-card">
        <p class="eyebrow">{t(locale, 'error.title')}</p>
        <h1>{t(locale, 'error.heading')}</h1>
        <p>{t(locale, 'error.body')}</p>
        <div class="actions">
          <a class="button" href={localizedPath(locale, '/order')}>
            {t(locale, 'error.tryAgain')}
          </a>
          <a class="button button--secondary" href={business.phoneHref}>
            {t(locale, 'error.call')}
          </a>
        </div>
      </section>
    </div>
  </main>
</Base>

<style>
  .error-card {
    max-width: 760px;
    padding: clamp(1.5rem, 5vw, 3rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: var(--shadow);
  }

  h1 {
    margin-bottom: 0.8rem;
    font-size: clamp(2.6rem, 9vw, 5rem);
  }

  .error-card > p:not(.eyebrow) {
    color: var(--color-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
</style>
